APP_ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/postgres
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
MARKET_DATA_MODE=live
FILING_ALLOWED_HOSTS=nseindia.com,bseindia.com,sebi.gov.in,ril.com
FILING_MAX_DOWNLOAD_MB=25
FILING_STORAGE_BUCKET=financial-filings
# SEC requires an identifiable application name and a real contact email.
SEC_USER_AGENT=VibeFinance your-email@example.com
# Optional LLM configuration. Enable exactly one provider preset.
#
# Anthropic Claude (recommended general-purpose preset)
# LLM_API_KEY=sk-ant-api03-your-anthropic-api-key
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# LLM_BASE_URL=https://api.anthropic.com
#
# OpenAI Codex API (requires an OpenAI API key, not a ChatGPT login)
# LLM_API_KEY=sk-proj-your-openai-api-key
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.3-codex
# LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
